# Copiar a .env (no versionar). Lo leen docker-compose y el backend.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docsearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docsearch

# RabbitMQ (RABBITMQ_URL es obligatoria; usuario/clave deben coincidir con los de la URL)
RABBITMQ_USER=docsearch
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://docsearch:change-me@localhost:5672

# Auth (JWT_SECRET es obligatorio: el backend no arranca sin él)
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=6h

# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Carga de documentos (el directorio se comparte con el Document Worker)
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
